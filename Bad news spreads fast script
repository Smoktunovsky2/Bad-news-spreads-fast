-- Kill All function
local function KillAllPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
            local hum = player.Character.Humanoid
            ReplicatedStorage.kill:FireServer(hum, true)
        end
    end
end

-- Kill All spam function
local function StartKillAllSpam()
    if KillAllSpamConnection then
        KillAllSpamConnection:Disconnect()
    end
    
    KillAllSpamConnection = RunService.Heartbeat:Connect(function()
        if not KillAllSpamEnabled then
            KillAllSpamConnection:Disconnect()
            return
        end
        KillAllPlayers()
        -- Add delay based on speed
        if SpamSpeed > 1 then
            wait(SpamSpeed / 1000) -- Convert milliseconds to seconds
        end
    end)
end

-- Stop Kill All spam function
local function StopKillAllSpam()
    KillAllSpamEnabled = false
    if KillAllSpamConnection then
        KillAllSpamConnection:Disconnect()
        KillAllSpamConnection = nil
    end
end

-- Create Highlight ESP function
local function CreateHighlightESP(player)
    if ESPConnections[player] then return end
    
    local connection
    connection = player.CharacterAdded:Connect(function(character)
        task.wait(1)
        
        if not ESPEnabled then return end
        
        local humanoid = character:WaitForChild("Humanoid")
        
        -- Create Highlight for ESP
        local highlight = Instance.new("Highlight")
        highlight.Name = player.Name .. "_ESP"
        highlight.Adornee = character
        highlight.Parent = ESPFolder
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        -- Wallhack visibility settings
        highlight.FillTransparency = 0.8  -- Semi-transparent fill
        highlight.OutlineTransparency = 0  -- Opaque outline
        
        -- Color settings
        if player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then
                highlight.FillColor = Color3.fromRGB(0, 255, 0)  -- Green for allies
                highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
            else
                highlight.FillColor = Color3.fromRGB(255, 0, 0)  -- Red for enemies
                highlight.OutlineColor = Color3.fromRGB(200, 0, 0)
            end
        else
            highlight.FillColor = Color3.fromRGB(255, 255, 0)  -- Yellow for neutral
            highlight.OutlineColor = Color3.fromRGB(200, 200, 0)
        end
        
        ESPHighlights[player] = highlight
        
        -- Connection for ESP removal on death
        humanoid.Died:Connect(function()
            if highlight and highlight.Parent then
                highlight:Destroy()
                ESPHighlights[player] = nil
            end
        end)
        
        -- Connection for update on character removal
        character.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if highlight and highlight.Parent then
                    highlight:Destroy()
                    ESPHighlights[player] = nil
                end
            end
        end)
    end)
    
    -- Create ESP for existing character
    if player.Character and ESPEnabled then
        task.spawn(function()
            local character = player.Character
            local humanoid = character:WaitForChild("Humanoid")
            
            -- Create Highlight for ESP
            local highlight = Instance.new("Highlight")
            highlight.Name = player.Name .. "_ESP"
            highlight.Adornee = character
            highlight.Parent = ESPFolder
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            
            -- Wallhack visibility settings
            highlight.FillTransparency = 0.8
            highlight.OutlineTransparency = 0
            
            -- Color settings
            if player.Team and LocalPlayer.Team then
                if player.Team == LocalPlayer.Team then
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
                else
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                    highlight.OutlineColor = Color3.fromRGB(200, 0, 0)
                end
            else
                highlight.FillColor = Color3.fromRGB(255, 255, 0)
                highlight.OutlineColor = Color3.fromRGB(200, 200, 0)
            end
            
            ESPHighlights[player] = highlight
            
            -- Connection for ESP removal on death
            humanoid.Died:Connect(function()
                if highlight and highlight.Parent then
                    highlight:Destroy()
                    ESPHighlights[player] = nil
                end
            end)
            
            -- Connection for update on character removal
            character.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    if highlight and highlight.Parent then
                        highlight:Destroy()
                        ESPHighlights[player] = nil
                    end
                end
            end)
        end)
    end
    
    ESPConnections[player] = connection
end

-- Enable ESP function
local function EnableESP()
    ESPEnabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            CreateHighlightESP(player)
        end
    end
    
    -- Connection for new players
    ESPConnections.playerAdded = Players.PlayerAdded:Connect(function(player)
        CreateHighlightESP(player)
    end)
    
    -- Connection for leaving players
    ESPConnections.playerRemoving = Players.PlayerRemoving:Connect(function(player)
        if ESPHighlights[player] then
            ESPHighlights[player]:Destroy()
            ESPHighlights[player] = nil
        end
        if ESPConnections[player] then
            ESPConnections[player]:Disconnect()
            ESPConnections[player] = nil
        end
    end)
end

-- Disable ESP function
local function DisableESP()
    ESPEnabled = false
    -- Clear all Highlights
    for player, highlight in pairs(ESPHighlights) do
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
    end
    ESPHighlights = {}
    
    -- Disconnect all connections
    for _, connection in pairs(ESPConnections) do
        if connection then
            connection:Disconnect()
        end
    end
    ESPConnections = {}
end

-- RGB animation for ESP
local hue = 0
local rgbConnection

rgbConnection = RunService.RenderStepped:Connect(function()
    if RGBMode and ESPEnabled then
        hue = (hue + 0.02) % 1
        local color = Color3.fromHSV(hue, 1, 1)
        
        for player, highlight in pairs(ESPHighlights) do
            if highlight and highlight.Parent and player ~= LocalPlayer then
                if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
                    -- Allies stay green
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                    highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
                else
                    -- Enemies get RGB colors
                    highlight.FillColor = color
                    highlight.OutlineColor = color
                end
            end
        end
    end
end)

